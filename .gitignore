# Ignore all generated files :
*.[oa]
*.cmd
*.tmp*
*.log
*.ko
*.mk
*.builtin
*.dtb
*.su
*.pyc
*.backup
*.itb

build/bitbake
build/bitbake.lock
build/cache

# Per-machine bitbake overrides, included by build/meta/conf/bitbake.conf
/build/conf/site.conf

# TEZI HTTP feed published by deploy.sh, plus the feed server's pid/log, and
# the makeusr.sh local deploy. Deliberately outside build/tmp so a clean does
# not wipe a feed a board may be installing from.
/build/deploy/

# do_attach_infrabase records what it wrote (base.bbclass), one manifest per
# attached component tree, so the next attach can refuse to clobber local edits.
*.attach.sha256
*.attach.pf

**/doxy/**
**/generated/**
**/rootfs/build/**
**/rootfs/host/**
**/rootfs/target/**
**/doc/build/**
**/linux/usr/build/**
# AVZ is fetched from the SO3 repository by the avz recipe
# (meta-avz/recipes-avz/avz) and built in place — never committed.
avz/**

vmlinux*
uImage*
modules.order
**/include/config/**

# Generated cpio
*.cpio

# Backup files
*~
*.back

# Dependency files produced by in-tree component builds. The negation is
# load-bearing: an unanchored "*.d" also excludes any DIRECTORY named *.d,
# and git then never descends into it — so a board overlay's etc/init.d/,
# modules-load.d/, sysctl.d/ … silently never reached a commit, and a fresh
# clone built a subtly different rootfs from the working tree. Files keep
# being ignored; directories are re-included.
*.d
!*.d/

# Hidden files
.*

# Bitbake build
**/build/tmp/**

# Build system generated directories
u-boot
/qemu
linux/linux
rootfs/buildroot

# Rendered ITS + assembled ITB. The ITS *sources* are tracked under
# build/meta-bsp/recipes-bsp/linux/files/its/; do_render_its expands their
# ${IB_*_PATH} placeholders into this directory, so what lands here is a
# build product carrying absolute machine paths.
/linux/images/

# so3 is fetched from the official repository
#so3

# except the followings:
!.gitignore #Don't ignore the ignore file ;-)
!*.tmpl #TaMPLate files for the man documentation

