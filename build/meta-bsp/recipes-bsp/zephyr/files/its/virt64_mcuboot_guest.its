/*
 * Copyright (C) 2026 EDGEMTech SA <info@edgemtech.ch>
 *
 * MCUboot as an AVZ guest, for the boot target that asks for a bootloader.
 * This is the shape a product tree with a hypervisor normally runs.
 *
 * A GUEST bundle, the same shape as virt64_zephyr_guest.its, and loaded the
 * same way — U-Boot's guest-boot command takes the AVZ ITB and this one. The
 * point of the exercise is that the developer's chain is the product's:
 * ATF, OP-TEE, U-Boot, AVZ, then the bootloader, then the application. A
 * bootloader entered by plain bootm would run somewhere the hardware never
 * runs it.
 *
 * 0x41000000 is not a free choice: AVZ enters the guest at the IPA its FDT
 * declares, whatever address the ITB loaded it at, so the first image in the
 * domain must be linked there. The application MCUboot RAM-loads goes to
 * 0x48000000 instead. See conf/ib_virt64-payload.overlay.
 *
 * Template: ${IB_*} placeholders are expanded to absolute build paths by
 * bsp_render_its (bsp.bbclass) at do_render_its time.
 *
 * This program is free software; you can redistribute it and/or modify
 * it under the terms of the GNU General Public License version 2 as
 * published by the Free Software Foundation.
 */

/dts-v1/;

/ {
	description = "MCUboot guest bundle for virt64 (armv8)";

	images {

		zephyr {
			description = "MCUboot (guest)";
			data = /incbin/("${IB_ZEPHYR_BOOT_IMAGE}");
			type = "guest";
			arch = "arm64";
			os = "linux";
			compression = "none";
			load = <0x41000000>;
			entry = <0x41000000>;
		};

		fdt {
			description = "Guest device tree (AVZ-exposed)";
			data = /incbin/("${IB_ZEPHYR_FDT}");
			type = "flat_dt";
			arch = "arm64";
			compression = "none";
			load = <0x50000000>;
		};
	};

	configurations {
		default = "capsule";

		capsule {
			description = "MCUboot guest on virt64";
			loadables = "zephyr";
			fdt = "fdt";
		};
	};
};
